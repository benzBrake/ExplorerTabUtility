<UserControl x:Class="ExplorerTabUtility.UI.Views.HotKeyProfileControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ExplorerTabUtility.UI.Views.Controls"
             xmlns:loc="clr-namespace:ExplorerTabUtility.Localization"
             mc:Ignorable="d"
             TextBlock.Foreground="{StaticResource TextPrimaryBrush}"
             TextElement.Foreground="{StaticResource TextPrimaryBrush}"
             d:DesignHeight="125" d:DesignWidth="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Border Style="{StaticResource ProfileCardStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Main Row -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Enabled Toggle -->
                <ToggleButton x:Name="CbEnabled" Grid.Column="0" Style="{StaticResource ToggleButtonStyle}"
                              VerticalAlignment="Stretch" ToolTip="{loc:Loc Profile.EnableTip}" />

                <!-- Name -->
                <TextBox x:Name="TxtName" Grid.Column="1" Tag="{loc:Loc Profile.Name}" Style="{StaticResource CustomTextBoxStyle}"
                         ToolTip="{loc:Loc Profile.NameTip}" />

                <!-- Hotkeys -->
                <TextBox x:Name="TxtHotKeys" Grid.Column="3" Tag="{loc:Loc Profile.Hotkeys}" Style="{StaticResource CustomTextBoxStyle}"
                         ToolTip="{loc:Loc Profile.HotkeysTip}" />

                <!-- Scope -->
                <ComboBox x:Name="CbScope" Grid.Column="5" Style="{StaticResource CustomComboBoxStyle}"
                          ToolTip="{loc:Loc Profile.ScopeTip}" />

                <!-- Action -->
                <ComboBox x:Name="CbAction" Grid.Column="6" Style="{StaticResource CustomComboBoxStyle}" Width="150"
                          ToolTip="{loc:Loc Profile.ActionTip}" />

                <!-- Expander button -->
                <ToggleButton x:Name="ExpanderToggle" Grid.Column="7" Margin="4, 0" Style="{StaticResource ToggleButtonArrowStyle}"
                              ToolTip="{loc:Loc Profile.MoreTip}" />

                <!-- Delete Button -->
                <Button x:Name="BtnDelete" Grid.Column="8" ToolTip="{loc:Loc Profile.DeleteTip}">
                    <Path Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" Width="16"
                          Height="16" />
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- Expanded Details -->
            <Grid x:Name="ExpandedPanel" Grid.Row="1" Margin="0, 6, 0, 0"
                  Visibility="{Binding ElementName=ExpanderToggle, Path=IsChecked, Mode=TwoWay, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Path -->
                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="TxtPath" Tag="{loc:Loc Profile.Location}" Style="{StaticResource CustomTextBoxStyle}"
                             ContextMenu="{StaticResource TextBoxCustomContextMenu}"
                             ToolTip="{loc:Loc Profile.LocationTip}" />
                    <Path Grid.Column="1" Width="16" Height="16" Margin="4,0" VerticalAlignment="Center"
                          Fill="{StaticResource TextTertiaryBrush}" Cursor="Help" Stretch="Uniform"
                          ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="20000"
                          Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z">
                        <Path.ToolTip>
                            <ToolTip MaxWidth="320">
                                <TextBlock Text="{loc:Loc Profile.LocationTip}" TextWrapping="Wrap" />
                            </ToolTip>
                        </Path.ToolTip>
                    </Path>
                </Grid>

                <!-- Delay -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6"
                            ToolTip="{loc:Loc Profile.DelayTip}">
                    <TextBlock Text="{loc:Loc Profile.Delay}" VerticalAlignment="Center" Margin="0,0,6,0" />

                    <controls:NumericInputControl x:Name="NDelay"
                                                  Margin="0"
                                                  MinWidth="100"
                                                  Minimum="0"
                                                  Maximum="10000"
                                                  Step="100"
                                                  Suffix="ms"
                                                  StringFormat="{}{0:N0}" />
                </StackPanel>

                <!-- Handled -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton x:Name="CbHandled" Content="{loc:Loc Profile.Handled}" Style="{StaticResource ToggleButtonStyle}" Margin="5,0" />
                    <Path Width="16" Height="16" Margin="0,0,4,0" VerticalAlignment="Center"
                          Fill="{StaticResource TextTertiaryBrush}" Cursor="Help" Stretch="Uniform"
                          ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="20000"
                          Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z">
                        <Path.ToolTip>
                            <ToolTip MaxWidth="320">
                                <TextBlock Text="{loc:Loc Profile.HandledTip}" TextWrapping="Wrap" />
                            </ToolTip>
                        </Path.ToolTip>
                    </Path>
                </StackPanel>

                <!-- Open as Tab -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton x:Name="CbOpenAsTab" Content="{loc:Loc Profile.Tab}" Style="{StaticResource ToggleButtonStyle}" Margin="5,0" />
                    <Path Width="16" Height="16" Margin="0,0,4,0" VerticalAlignment="Center"
                          Fill="{StaticResource TextTertiaryBrush}" Cursor="Help" Stretch="Uniform"
                          ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="20000"
                          Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z">
                        <Path.ToolTip>
                            <ToolTip MaxWidth="320">
                                <TextBlock Text="{loc:Loc Profile.TabTip}" TextWrapping="Wrap" />
                            </ToolTip>
                        </Path.ToolTip>
                    </Path>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
